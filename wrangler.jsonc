{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "operashalem",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only the form endpoint runs the Worker; every page is served straight from dist/
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CONTACT_TO": "info@operashalem.com",
    // Must be an address on a domain verified in Resend
    "CONTACT_FROM": "Opera Shalem website <website@operashalem.com>"
  }
  // Secret, set with `npx wrangler secret put RESEND_API_KEY` or in the dashboard:
  //   RESEND_API_KEY
}
