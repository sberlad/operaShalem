---
import Base from '../layouts/Base.astro';
import '../styles/post.css';
---

<Base title="Page not found | Opera Shalem" description="The page you were looking for could not be found." noindex>
  <main>
    <article class="blog-post-page">
      <header class="post-header">
        <h1 class="post-title">Page not found</h1>
      </header>
      <div class="post-content">
        <p>We couldn't find that page. It may have moved when we updated the site.</p>
        <p><a href="/">Go to the homepage</a> or <a href="/blog">read the blog</a>.</p>
      </div>
    </article>
  </main>
</Base>
