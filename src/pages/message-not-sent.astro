---
// Shown after a contact form submission when JavaScript is unavailable
import Base from '../layouts/Base.astro';
import '../styles/post.css';
---

<Base title="Your message was not sent | Opera Shalem" description="Contact form result." noindex>
  <main>
    <article class="blog-post-page">
      <header class="post-header">
        <h1 class="post-title">Your message was not sent</h1>
      </header>
      <div class="post-content">
        <p>Something went wrong and your message did not reach us. Please <a href="/#partner">try again</a>, or email us directly at <a href="mailto:info@operashalem.com">info@operashalem.com</a>.</p>
      </div>
    </article>
  </main>
</Base>
