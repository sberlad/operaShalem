---
// Shown after a contact form submission when JavaScript is unavailable
import Base from '../layouts/Base.astro';
import '../styles/post.css';
---

<Base title="Thank you | Opera Shalem" description="Contact form result." noindex>
  <main>
    <article class="blog-post-page">
      <header class="post-header">
        <h1 class="post-title">Thank you</h1>
      </header>
      <div class="post-content">
        <p>Your message has been sent. We will be in touch soon.</p>
        <p><a href="/">Back to the homepage</a></p>
      </div>
    </article>
  </main>
</Base>
